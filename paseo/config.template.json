{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "injectIntoAgents": true
    },
    "autoArchiveAfterMerge": true,
    "terminalProfiles": [
      {
        "id": "pi",
        "name": "Pi",
        "command": "pi",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "pi"
      },
      {
        "id": "claude",
        "name": "Claude Code",
        "command": "claude",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "claude"
      },
      {
        "id": "codex",
        "name": "Codex",
        "command": "codex",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "codex"
      },
      {
        "id": "opencode",
        "name": "OpenCode",
        "command": "opencode",
        "args": [
          "--prompt={{{prompt}}}"
        ],
        "icon": "opencode"
      }
    ],
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": true
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "pluginsEnabled": true,
  "agents": {
    "providers": {
      "copilot": {
        "enabled": false
      },
      "opencode": {
        "enabled": false
      }
    },
    "metadataGeneration": {
      "providers": [
        {
          "provider": "pi",
          "model": "cliproxyapi/claude-opus-5"
        }
      ]
    }
  }
}
