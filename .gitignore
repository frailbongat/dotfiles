# ============================================================
# WHITELIST. Everything is ignored by default.
# Nothing reaches GitHub unless it is un-ignored below.
# To add a folder later, add a line:  !/foldername/
# ============================================================
/*

# --- Repo files ---
!/.gitignore
!/README.md
!/install.sh
!/Brewfile

# --- Included config ---
!/yabai/
!/skhd/
!/sketchybar/
!/.vscode/
!/mcp/
!/home/
!/paseo/

# Identity file. Belongs in ~/.gitconfig.local, outside this repo.
# Belt and braces in case it is ever copied in here.
.gitconfig.local
*.local

# ============================================================
# pi lives in frailbongat/pi-config, cloned to ~/.pi. It is not here.
# /pi/ stays off the whitelist above on purpose. Re-adding it would give
# pi two sources of truth again, which is how one machine ended up running
# config from 2026-09-14 for a month.
# ============================================================

# ============================================================
# Paseo: portable config templates only. The live ~/.paseo is never
# synced; it holds the daemon keypair, server id, and push tokens.
# The live desktop settings are not synced either; they sit beside
# window state, caches, and cookies in ~/Library/Application Support.
# ============================================================
/paseo/*
!/paseo/config.template.json
!/paseo/desktop-settings.template.json
!/paseo/app-settings.template.json
!/paseo/app-settings.mjs
!/paseo/icons/

# ============================================================
# Junk, inside any included folder
# ============================================================
.DS_Store
node_modules/
*.log
*.bak
*.orig
*~
*.sock
*.mdb

# Never, under any circumstance
*credentials*
*.pem
*.key
*.p12
.env
.env.*
