# focus space
alt - 1: yabai -m space --focus 1
alt - 2: yabai -m space --focus 2
alt - 3: yabai -m space --focus 3
alt - 4: yabai -m space --focus 4
alt - 5: yabai -m space --focus 5

# focus window
alt - i: yabai -m window --focus north
alt - j: yabai -m window --focus west
alt - k: yabai -m window --focus south
alt - l: yabai -m window --focus east

# swap managed window
shift + alt - i: yabai -m window --swap north
shift + alt - j: yabai -m window --swap west
shift + alt - k: yabai -m window --swap south
shift + alt - l: yabai -m window --swap east

# move managed window
shift + cmd - i: yabai -m window --warp north
shift + cmd - j: yabai -m window --warp west
shift + cmd - k: yabai -m window --warp south
shift + cmd - l: yabai -m window --warp east

# app shortcuts
# follow.sh: unmanaged (manage=off) apps get dragged to whatever space you're on
# plain open -a: tiled apps keep their space, hotkey jumps to them
alt - b: open -a 'Google Chrome'
alt + shift - b: ~/.config/skhd/follow.sh '^Zen$' 'Zen Browser'
# alt - b: open -a 'Vivaldi'
alt - c: open -a 'Visual Studio Code'
# alt - c: open -a 'ChatGPT'
alt - d: ~/.config/skhd/follow.sh '^Beeper$' 'Beeper Desktop'
# alt - d: open -a 'Discord'
alt - g: open -a 'Discord'
alt - e: open -a 'Spark Desktop'
alt + shift - f: open -a 'Figma'
alt - h: ~/.config/skhd/follow.sh '^Hoppscotch$' 'Hoppscotch'
alt - m: open -a 'Spotify'
alt - n: ~/.config/skhd/follow.sh '^Messenger$' 'Messenger'
alt + shift - n: ~/.config/skhd/follow.sh '^Messages$' 'Messages'
alt - o: ~/.config/skhd/follow.sh '^Obsidian$' 'Obsidian'
alt - r: ~/.config/skhd/follow.sh '^Raindrop.io$' 'Raindrop.io.app'
alt - s: open -a 'Slack'
alt - t: open -a 'Things3'
# alt - z: open -a 'iTerm'
alt - z: open -a 'Visual Studio Code'
# alt - a: open -a 'Seanime Denshi'
alt - 5: ~/.config/skhd/follow.sh '^PS Remote Play$' 'PS Remote Play'
alt - p : yabai -m window --toggle float
