# focus space
alt - 1: yabai -m space --focus 1
alt - 2: yabai -m space --focus 2
alt - 3: yabai -m space --focus 3
alt - 4: yabai -m space --focus 4
alt - 5: yabai -m space --focus 5

# focus window
alt - i: yabai -m window --focus north
alt - j: yabai -m window --focus west
alt - k: yabai -m window --focus south
alt - l: yabai -m window --focus east

# swap managed window
shift + alt - i: yabai -m window --swap north
shift + alt - j: yabai -m window --swap west
shift + alt - k: yabai -m window --swap south
shift + alt - l: yabai -m window --swap east

# move managed window
shift + cmd - i: yabai -m window --warp north
shift + cmd - j: yabai -m window --warp west
shift + cmd - k: yabai -m window --warp south
shift + cmd - l: yabai -m window --warp east

# app shortcuts
# follow.sh: window is dragged to whatever space you're on, every time
# jump.sh:   window keeps its space and you travel to it, but a first launch
#            (no window anywhere) opens on the space you're already on, unless
#            the app is pinned in ~/.config/yabai/pinned.sh
alt - b: ~/.config/skhd/jump.sh '^Zen$' 'Zen Browser'
alt + shift - b: ~/.config/skhd/jump.sh '^Google Chrome$' 'Google Chrome'
# alt - b: ~/.config/skhd/jump.sh '^Vivaldi$' 'Vivaldi'
alt - c: ~/.config/skhd/jump.sh '^Paseo$' 'Paseo'
# alt - c: ~/.config/skhd/jump.sh '^Superset$' 'Superset'
# alt - c: ~/.config/skhd/jump.sh '^Code$' 'Visual Studio Code'
# alt - c: ~/.config/skhd/jump.sh '^ChatGPT$' 'ChatGPT'
alt - d: ~/.config/skhd/follow.sh '^Beeper$' 'Beeper Desktop'
# alt - d: ~/.config/skhd/jump.sh '^Discord$' 'Discord'
alt - g: ~/.config/skhd/jump.sh '^Discord$' 'Discord'
alt - e: ~/.config/skhd/jump.sh '^Spark Desktop$' 'Spark Desktop'
alt + shift - f: ~/.config/skhd/jump.sh '^Figma$' 'Figma'
alt - h: ~/.config/skhd/follow.sh '^Hoppscotch$' 'Hoppscotch'
alt - m: ~/.config/skhd/jump.sh '^Spotify$' 'Spotify'
alt - n: ~/.config/skhd/follow.sh '^Messenger$' 'Messenger'
alt + shift - n: ~/.config/skhd/follow.sh '^Messages$' 'Messages'
alt - o: ~/.config/skhd/follow.sh '^Obsidian$' 'Obsidian'
alt - r: ~/.config/skhd/follow.sh '^Raindrop.io$' 'Raindrop.io.app'
alt - s: ~/.config/skhd/jump.sh '^Slack$' 'Slack'
alt - t: ~/.config/skhd/jump.sh '^Things$' 'Things3'
# alt - z: ~/.config/skhd/jump.sh '^iTerm2$' 'iTerm'
alt - z: ~/.config/skhd/jump.sh '^Code$' 'Visual Studio Code'
# alt - a: open -a 'Seanime Denshi'
alt - 5: ~/.config/skhd/follow.sh '^PS Remote Play$' 'PS Remote Play'
alt - p : yabai -m window --toggle float
