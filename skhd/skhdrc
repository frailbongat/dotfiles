# focus space
ctrl - 1: yabai -m space --focus 1
ctrl - 2: yabai -m space --focus 2
ctrl - 3: yabai -m space --focus 3
ctrl - 4: yabai -m space --focus 4
ctrl - 5: yabai -m space --focus 5

# focus window
ctrl - i: yabai -m window --focus north
ctrl - j: yabai -m window --focus west
ctrl - k: yabai -m window --focus south
ctrl - l: yabai -m window --focus east

# swap managed window
shift + ctrl - i: yabai -m window --swap north
shift + ctrl - j: yabai -m window --swap west
shift + ctrl - k: yabai -m window --swap south
shift + ctrl - l: yabai -m window --swap east

# move managed window
shift + cmd - i: yabai -m window --warp north
shift + cmd - j: yabai -m window --warp west
shift + cmd - k: yabai -m window --warp south
shift + cmd - l: yabai -m window --warp east

# app shortcuts
ctrl - b: open -a 'Zen'
ctrl - c: open -a 'Codex'
ctrl - d: open -a 'Legcord'
ctrl - e: open -a 'Spark Desktop'
ctrl + shift - f: open -a 'Figma'
ctrl - h: open -a 'Hoppscotch'
ctrl - m: open -a 'Spotify'
ctrl - n: open -a 'Messenger'
ctrl - o: open -a 'Obsidian'
ctrl - r: open -a 'Raindrop.io.app'
ctrl - s: open -a 'Slack'
ctrl - t: open -a 'TickTick'
ctrl - z: open -a 'Zed'
