#!/usr/bin/env sh

sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# Open apps on the space you are actually looking at. travel.sh handles apps
# that already have a window, place.sh catches the window of an app that had
# none. Requires the Dock default workspaces-auto-swoosh to be NO, which
# install.sh sets. Both scripts have the full explanation at the top.
yabai -m signal --add event=application_activated action="~/.config/yabai/travel.sh \$YABAI_PROCESS_ID"
yabai -m signal --add event=window_created action="~/.config/yabai/place.sh \$YABAI_WINDOW_ID"

# Tracing for the two signals above. Silent unless /tmp/yabai-debug exists.
# Window close and space change are the events you need to read the log, and
# they are the ones yabai does not otherwise record.
yabai -m signal --add label=dbg_destroy event=window_destroyed \
  action='[ -f /tmp/yabai-debug ] && echo "$(date "+%H:%M:%S") DESTROY wid=$YABAI_WINDOW_ID" >> /tmp/travel.log'
yabai -m signal --add label=dbg_space event=space_changed \
  action='[ -f /tmp/yabai-debug ] && echo "$(date "+%H:%M:%S") SPACE -> $(yabai -m query --spaces | jq -r ".[] | select(.\"has-focus\") | .index")" >> /tmp/travel.log'

# defaults
yabai -m config layout bsp

yabai -m config top_padding 8
yabai -m config bottom_padding 8
yabai -m config left_padding 8
yabai -m config right_padding 8
yabai -m config window_gap 10
yabai -m config external_bar all:32:0

yabai -m config mouse_follows_focus on
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap
yabai -m config focus_follows_mouse autoraise

yabai -m config auto_balance off
yabai -m config split_ratio 0.50
yabai -m config window_shadow float
yabai -m config window_placement second_child
yabai -m config insert_feedback_color 0xff9dd274

# apps spaces
#
# The old `space=` pins are gone. They fired on every window creation, so a
# first launch always got yanked to a fixed space instead of opening where you
# were standing. Placement now lives in ~/.config/skhd/jump.sh:
#
#   window exists -> focus it, you travel to its space
#   no window     -> open on the space you're already on
#
# Old pins, kept for reference: Code/Vivaldi/Things3 -> 1, Figma/Slack -> 2,
# Spark/Discord/PS Remote Play -> 3, Spotify -> 4.

# disable apps
yabai -m rule --add app="^(Calculator|Software Update|Dictionary|System Preferences|System Settings|zoom.us|Photo Booth|Archive Utility|App Store|Alfred|Activity Monitor)$" manage=off
yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off
